#!/usr/bin/env python3
"""FireStudio Tube control panel, modelled on PreSonus Universal Control.

Follows the Device Window described in section 3.1.4 of the FireStudio Tube
manual: one zero-latency mix per stereo output (Main, Out 3-4, Out 5-6,
Headphones), each with a Mixer On/Off switch (off = the DAW streams of that
output go straight to it), a master fader, and channel strips with input
selector, fader (-inf..+6 dB), pan, link, mute and solo.

The DICE mixer only stores one gain per input and mixer output, so master,
mute, solo and link are kept in ~/.config/firestudio-tube/state.json and the
resulting gains are written to the device.
"""

import json
import math
import os
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import tube  # noqa: E402

PRESETS = os.path.join(HERE, "presets")
STATE_FILE = os.path.expanduser("~/.config/firestudio-tube/state.json")
FADER_MIN, FADER_MAX, MASTER_MAX = -60.0, 6.0, 0.0
METER_FLOOR = -60.0
CLIP_DB = -0.5
PEAK_HOLD_TICKS = 12  # ~1.5 s at 120 ms

# Universal Control's four output mixes: (name, first physical output).
# Mix k uses DICE mixer outputs 2k/2k+1 and, when its mixer is off, DAW streams 2k+1/2k+2.
OUTPUTS = [("Main", 0), ("Out 3-4", 2), ("Out 5-6", 4), ("Fones", 6)]
SOURCE_CHOICES = [f"Analog-A-{n}" for n in range(1, 17)] + [f"Stream-{n}" for n in range(1, 9)]

