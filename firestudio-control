    def show_clock(self):
        rate, quantum = tube.current_clock()
        self.updating_clock = True
        self.rate_combo.set_active_id(str(rate))
        self.buffer_combo.set_active_id(str(quantum))
        self.updating_clock = False
        self.clock_edited(None)
        self.status.set_text(f"{rate / 1000:g} kHz · buffer {quantum}"
                             f"{'' if self.tube.locked() else ' · clock NÃO travado'}")

    def chosen_clock(self):
        rate = int(self.rate_combo.get_active_id() or 48000)
        quantum = int(self.buffer_combo.get_active_id() or 1024)
        return rate, quantum

    def clock_edited(self, _combo):
        rate, quantum = self.chosen_clock()
        self.latency.set_text(f"{1000 * quantum / rate:.1f} ms por buffer")
        if not getattr(self, "updating_clock", False):
            self.clock_msg.set_text("")

    def apply_clock(self, _b):
        if not self.tube:
            return
        rate, quantum = self.chosen_clock()
        old_rate = tube.current_clock()[0]
        desired = self.tube.snapshot()
        self.clock_apply.set_sensitive(False)
        self.clock_spinner.start()
        self.clock_msg.set_text("Aplicando…")
        self.tube = None  # pause the meters while the device reconfigures

        def work():
            error = None
            try:
                tube.set_clock(rate, quantum)
                if rate != old_rate:
                    # The DICE reloads its router from flash when the rate changes:
                    # wait for it, put the configuration back and store it for this rate.
                    t = None
                    for attempt in range(30):
                        if attempt % 5 == 0:
                            tube.wake_stream()
                        try:
                            t = tube.Tube()
                            if int(t.sample_rate()) == rate:
                                break
                        except (RuntimeError, subprocess.CalledProcessError, KeyError):
                            pass
                        t = None
                        GLib.usleep(300_000)
                    if t is None:
                        raise RuntimeError("a placa não mudou de taxa")
                    GLib.usleep(1_500_000)  # let the device finish reloading its flash
                    tube.apply_and_store(desired)
            except (RuntimeError, subprocess.CalledProcessError, OSError) as e:
                error = str(e)
            GLib.idle_add(done, error)

        def done(error):
            self.clock_spinner.stop()
            self.clock_apply.set_sensitive(True)
            self.connect_device(page="config")
            self.clock_msg.set_text(f"Erro: {error}" if error else
                                    f"Pronto: {rate / 1000:g} kHz, buffer {quantum}.")
            return False

        threading.Thread(target=work, daemon=True).start()

