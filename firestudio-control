class Strip(Gtk.Box):
    """One mixer channel: input selector, mute/solo, peak, meter, fader, pan, link."""

    def __init__(self, panel, slot):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        self.panel, self.slot, self.updating = panel, slot, False
        self.get_style_context().add_class("strip")

        self.source = Gtk.ComboBoxText()
        for item in SOURCE_CHOICES:
            self.source.append(item, tube.source_label(item))
        self.source.get_style_context().add_class("small")
        self.source.connect("changed", self.source_changed)
        self.pack_start(self.source, False, False, 0)

        buttons = Gtk.Box(spacing=2, homogeneous=True)
        self.mute = Gtk.ToggleButton(label="M", tooltip_text="Mute")
        self.solo = Gtk.ToggleButton(label="S", tooltip_text="Solo")
        self.mute.get_style_context().add_class("mute")
        self.solo.get_style_context().add_class("solo")
        for b in (self.mute, self.solo):
            b.connect("toggled", self.changed)
            buttons.pack_start(b, True, True, 0)
        self.pack_start(buttons, False, False, 0)

        self.peak = Peak()
        self.pack_start(self.peak.label, False, False, 0)

        mid = Gtk.Box(spacing=3, halign=Gtk.Align.CENTER)
        self.fader = Gtk.Scale.new_with_range(Gtk.Orientation.VERTICAL, FADER_MIN, FADER_MAX, 0.5)
        self.fader.set_inverted(True)
        self.fader.set_draw_value(False)
        self.fader.add_mark(0, Gtk.PositionType.LEFT, None)
        self.fader.set_size_request(-1, 170)
        self.fader.connect("value-changed", self.changed)
        self.fader.set_tooltip_text("Ctrl + clique volta para 0 dB")
        ctrl_click_resets(self.fader, 0.0)
        self.meter = new_meter()
        mid.pack_start(self.fader, False, False, 0)
        mid.pack_start(self.meter, False, False, 0)
        self.pack_start(mid, True, True, 0)

        self.db = Gtk.Label()
        self.db.get_style_context().add_class("mono")
        self.pack_start(self.db, False, False, 0)

        self.pan = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, -1, 1, 0.05)
        self.pan.set_draw_value(False)
        self.pan.add_mark(0, Gtk.PositionType.BOTTOM, None)
        self.pan.set_size_request(70, -1)
        self.pan.set_tooltip_text("Pan — duplo clique ou Ctrl + clique centraliza")
        self.pan.connect("value-changed", self.changed)
        ctrl_click_resets(self.pan, 0.0)
        self.pan.connect("button-press-event", self.pan_reset)
        self.pack_start(self.pan, False, False, 0)

        # Link button sits on the first channel of each pair (1-2, 3-4, ...)
        if slot % 2 == 0:
            self.link = Gtk.ToggleButton(label="Link ↔", tooltip_text=(
                "Liga este canal ao próximo como par estéreo: mesmo nível, pan L/R"))
            self.link.get_style_context().add_class("link")
            self.link.get_style_context().add_class("small")
            self.link.connect("toggled", self.link_toggled)
            self.pack_start(self.link, False, False, 0)
        else:
            self.link = None
            self.pack_start(Gtk.Label(label=" "), False, False, 4)

    def display(self, source, ch, linked_partner):
        self.updating = True
        self.source.set_active_id(source if source in SOURCE_CHOICES else None)
        (self.get_style_context().add_class if source.startswith("Stream")
         else self.get_style_context().remove_class)("daw")
        self.fader.set_value(ch["db"])
        self.pan.set_value(ch["pan"])
        self.mute.set_active(ch["mute"])
        self.solo.set_active(ch["solo"])
        self.db.set_text(fmt_db(ch["db"]))
        self.pan.set_sensitive(not linked_partner)
        self.updating = False

    def show_link(self, linked):
        if self.link:
            self.updating = True
            self.link.set_active(linked)
            self.updating = False

    def pan_reset(self, _w, event):
        if event.button == 1 and event.type == Gdk.EventType._2BUTTON_PRESS:
            self.pan.set_value(0)
            return True
        return False

    def changed(self, _w):
        if self.updating:
            return
        self.db.set_text(fmt_db(self.fader.get_value()))
        self.panel.channel_changed(self.slot, {
            "db": self.fader.get_value(), "pan": self.pan.get_value(),
            "mute": self.mute.get_active(), "solo": self.solo.get_active()})

    def source_changed(self, combo):
        if not self.updating and combo.get_active_id():
            self.panel.source_changed(self.slot, combo.get_active_id())

    def link_toggled(self, btn):
        if not self.updating:
            self.panel.link_changed(self.slot // 2, btn.get_active())


class Panel(Gtk.Window):
    def __init__(self):
        super().__init__(title="FireStudio Tube")
        self.set_default_size(1400, 560)
        self.tube = None
        self.state = None
        self.out = 0
        self.flush_id = None

        header = Gtk.HeaderBar(show_close_button=True)
        self.set_titlebar(header)
        self.set_title("FireStudio Tube")
        self.set_icon_from_file(os.path.join(HERE, "assets", "firestudio-tube.svg"))
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        header.set_custom_title(Gtk.StackSwitcher(stack=self.stack))
        self.status = Gtk.Label()
        self.status.get_style_context().add_class("hint")
        header.pack_end(self.status)
        self.add(self.stack)

        self.build_mixer()
        self.build_settings()
        self.build_presets()
        # Shown instead of the tabs when the device or the service is missing.
        self.error = Gtk.Label(wrap=True, margin=30)
        self.stack.add_named(self.error, "status")

        self.show_all()
        self.error.hide()  # a hidden page gets no (empty) button in the switcher
        self.connect_device()
        GLib.timeout_add(120, self.poll_meters)

    # Device ---------------------------------------------------------------------
    def connect_device(self, page="mixer"):
        try:
            self.tube = tube.Tube()
            self.tube.enable_metering()
            self.state = load_state(self.tube)
        except (RuntimeError, subprocess.CalledProcessError, KeyError) as e:
            self.tube = None
            self.error.set_text(f"{e}\n\nLigue a placa e rode:\n"
                                "systemctl --user restart firestudio-tube-ctl")
            self.error.show()
            self.stack.set_visible_child_name("status")
            self.status.set_text("desconectada")
            return False
        self.show_clock()
        self.out = self.state.get("out", 0) if 0 <= self.state.get("out", 0) < len(OUTPUTS) else 0
        self.show_output()
        self.error.hide()
        self.stack.set_visible_child_name(page)
        self.strips_scroll.get_hadjustment().set_value(0)
        return False

    def mixer_on(self, k):
        return self.tube.output_sources()[OUTPUTS[k][1]] == f"Mixer-{2 * k + 1}"

    # Mixer page -------------------------------------------------------------------
    def build_mixer(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=10)

        # Output Select section
        top = Gtk.Box(spacing=6)
        self.out_buttons = []
        group = None
        for k, (name, _) in enumerate(OUTPUTS):
            btn = Gtk.RadioButton.new_with_label_from_widget(group, name)
            btn.set_mode(False)
            btn.get_style_context().add_class("outbtn")
            btn.connect("toggled", self.output_selected, k)
            group = group or btn
            top.pack_start(btn, False, False, 0)
            self.out_buttons.append(btn)

        top.pack_start(Gtk.Label(label="   Mixer"), False, False, 0)
        self.mixer_switch = Gtk.Switch(valign=Gtk.Align.CENTER, tooltip_text=(
            "Ligado: mix com latência zero para esta saída.\n"
            "Desligado: os canais DAW desta saída vão direto para ela."))
        self.mixer_switch.connect("notify::active", self.mixer_toggled)
        top.pack_start(self.mixer_switch, False, False, 0)
        self.mode_label = Gtk.Label(xalign=0)
        self.mode_label.get_style_context().add_class("hint")
        top.pack_start(self.mode_label, True, True, 8)
        page.pack_start(top, False, False, 0)

        body = Gtk.Box(spacing=8)
        self.strips_box = Gtk.Box(spacing=4)
        self.strips = [Strip(self, s) for s in range(tube.MIXER_INPUTS)]
        for s in self.strips:
            self.strips_box.pack_start(s, False, False, 0)
        self.strips_scroll = Gtk.ScrolledWindow()
        self.strips_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
        self.strips_scroll.add(self.strips_box)
        body.pack_start(self.strips_scroll, True, True, 0)

        # Master Output section
        master = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        master.get_style_context().add_class("master")
        self.master_title = Gtk.Label()
        self.master_title.get_style_context().add_class("section")
        master.pack_start(self.master_title, False, False, 0)
        clear = Gtk.Box(spacing=2, homogeneous=True)
        self.clear_mute = Gtk.Button(label="M clr", tooltip_text="Limpar todos os mutes")
        self.clear_solo = Gtk.Button(label="S clr", tooltip_text="Limpar todos os solos")
        self.clear_mute.connect("clicked", self.clear_flags, "mute")
        self.clear_solo.connect("clicked", self.clear_flags, "solo")
        clear.pack_start(self.clear_mute, True, True, 0)
        clear.pack_start(self.clear_solo, True, True, 0)
        master.pack_start(clear, False, False, 0)
        peaks = Gtk.Box(spacing=2, homogeneous=True)
        self.out_peaks = (Peak(), Peak())
        for p in self.out_peaks:
            peaks.pack_start(p.label, True, True, 0)
        peaks_events = Gtk.EventBox(tooltip_text="Clique para limpar o CLIP")
        peaks_events.add(peaks)
        peaks_events.connect("button-press-event", self.reset_out_peaks)
        master.pack_start(peaks_events, False, False, 0)
        mid = Gtk.Box(spacing=3, halign=Gtk.Align.CENTER)
        self.master = Gtk.Scale.new_with_range(Gtk.Orientation.VERTICAL, FADER_MIN, MASTER_MAX, 0.5)
        self.master.set_inverted(True)
        self.master.set_draw_value(False)
        self.master.set_size_request(-1, 170)
        self.master.connect("value-changed", self.master_changed)
        self.master.set_tooltip_text("Ctrl + clique volta para 0 dB")
        ctrl_click_resets(self.master, 0.0)
        self.out_meters = (new_meter(), new_meter())
        mid.pack_start(self.master, False, False, 0)
        for m in self.out_meters:
            mid.pack_start(m, False, False, 0)
        master.pack_start(mid, True, True, 0)
        self.master_db = Gtk.Label()
        self.master_db.get_style_context().add_class("mono")
        master.pack_start(self.master_db, False, False, 0)
        body.pack_start(master, False, False, 0)
        page.pack_start(body, True, True, 0)

        hint = Gtk.Label(xalign=0, wrap=True, label=(
            "Cada saída tem sua própria mix com latência zero (feita no DSP da placa). "
            "O som do computador (saída “FireStudio Tube”) entra nas mixes como DAW 1-2: use o "
            "fader ou o M de DAW 1-2 em cada saída para escolher onde ele toca. DAWs com acesso "
            "aos 8 canais (Pro Audio) também enviam DAW 3-8. "
            "Os medidores dos canais são pré-fader; os da saída mostram o nível real."))
        hint.get_style_context().add_class("hint")
        page.pack_start(hint, False, False, 0)
        self.stack.add_titled(page, "mixer", "Mixer")

    def reset_out_peaks(self, *_args):
        for p in self.out_peaks:
            p.reset()
        return True

    def output_selected(self, btn, k):
        if btn.get_active():
            self.out = k
            self.reset_out_peaks()
            if self.tube:
                self.state["out"] = k
                save_state(self.state)
                self.show_output()

    def show_output(self):
        k = self.out
        self.out_buttons[k].set_active(True)
        on = self.mixer_on(k)
        self.updating_switch = True
        self.mixer_switch.set_active(on)
        self.updating_switch = False
        name = OUTPUTS[k][0]
        first = 2 * k + 1
        if on:
            self.mode_label.set_text(f"Mix com latência zero → {name}")
        else:
            outs = self.tube.output_sources()[OUTPUTS[k][1]:OUTPUTS[k][1] + 2]
            direct = outs == [f"Stream-{first}", f"Stream-{first + 1}"]
            self.mode_label.set_text(
                f"Mixer desligado: DAW {first}-{first + 1} direto em {name}" if direct else
                f"Mixer desligado: {name} recebe {' / '.join(map(tube.source_label, outs))}")
        self.strips_box.set_sensitive(on)
        self.master.set_sensitive(on)

        sources = self.tube.mixer_sources()
        mix = self.state["mixes"][k]
        links = self.state["links"]
        for s, strip in enumerate(self.strips):
            strip.display(sources[s], mix["ch"][s], s % 2 == 1 and links[s // 2])
            strip.show_link(links[s // 2])
        self.master_title.set_text(name)
        self.updating_master = True
        self.master.set_value(mix["master"])
        self.updating_master = False
        self.master_db.set_text(fmt_db(mix["master"]))

    def mixer_toggled(self, switch, _param):
        if not self.tube or getattr(self, "updating_switch", False):
            return
        k = self.out
        start = OUTPUTS[k][1]
        outs = self.tube.output_sources()
        kind = "Mixer" if switch.get_active() else "Stream"
        outs[start:start + 2] = [f"{kind}-{2 * k + 1}", f"{kind}-{2 * k + 2}"]
        self.tube.set_output_sources(outs)
        self.show_output()

    def channel_changed(self, slot, values):
        mix = self.state["mixes"][self.out]
        mix["ch"][slot].update(values)
        if self.state["links"][slot // 2]:
            partner = slot ^ 1
            for key in ("db", "mute", "solo"):
                mix["ch"][partner][key] = values[key]
            self.strips[partner].display(self.tube.mixer_sources()[partner], mix["ch"][partner], True)
        self.queue_flush()

    def master_changed(self, scale):
        if getattr(self, "updating_master", False):
            return
        self.state["mixes"][self.out]["master"] = scale.get_value()
        self.master_db.set_text(fmt_db(scale.get_value()))
        self.queue_flush()

    def clear_flags(self, _b, key):
        for c in self.state["mixes"][self.out]["ch"]:
            c[key] = False
        self.show_output()
        self.queue_flush()

    def link_changed(self, pair, linked):
        self.state["links"][pair] = linked
        if linked:
            # Universal Control: linked channels share the level, panned hard left/right.
            for mix in self.state["mixes"]:
                a, b = mix["ch"][2 * pair], mix["ch"][2 * pair + 1]
                b["db"], b["mute"], b["solo"] = a["db"], a["mute"], a["solo"]
                a["pan"], b["pan"] = -1.0, 1.0
            self.flush_all()
        self.show_output()
        save_state(self.state)

    def source_changed(self, slot, item):
        sources = self.tube.mixer_sources()
        sources[slot] = item
        self.tube.set_mixer_sources(sources)
        self.show_output()

    def queue_flush(self):
        if self.flush_id is None:
            self.flush_id = GLib.timeout_add(40, self.flush)

    def flush(self):
        self.flush_id = None
        k = self.out
        left, right = mix_gains(self.state, k)
        try:
            self.tube.set_mixer_gains(2 * k, left)
            self.tube.set_mixer_gains(2 * k + 1, right)
            save_state(self.state)
        except subprocess.CalledProcessError:
            self.connect_device()
        return False

    def flush_all(self):
        for k in range(len(OUTPUTS)):
            left, right = mix_gains(self.state, k)
            self.tube.set_mixer_gains(2 * k, left)
            self.tube.set_mixer_gains(2 * k + 1, right)

