    def apply_file(self, path):
        if not self.tube:
            return
        preset = tube.load_preset(path)
        self.tube.apply(preset)
        self.state = preset["ui"] if "ui" in preset else load_state(self.tube)
        save_state(self.state)
        self.show_output()

    def file_dialog(self, action, accept):
        dialog = Gtk.FileChooserNative(title="Preset", transient_for=self, action=action,
                                       accept_label=accept)
        dialog.set_current_folder(PRESETS)
        flt = Gtk.FileFilter()
        flt.set_name("Presets (.json)")
        flt.add_pattern("*.json")
        dialog.add_filter(flt)
        if action == Gtk.FileChooserAction.SAVE:
            dialog.set_do_overwrite_confirmation(True)
            dialog.set_current_name("meu-preset.json")
        path = dialog.get_filename() if dialog.run() == Gtk.ResponseType.ACCEPT else None
        dialog.destroy()
        return path

    def open_preset(self, _b):
        path = self.file_dialog(Gtk.FileChooserAction.OPEN, "Abrir")
        if path:
            self.apply_file(path)

    def save_preset(self, _b):
        path = self.file_dialog(Gtk.FileChooserAction.SAVE, "Salvar")
        if path and self.tube:
            preset = self.tube.snapshot()
            preset["ui"] = self.state
            tube.save_preset(path if path.endswith(".json") else path + ".json", preset)

    def store(self, _b):
        # snd-dice-ctl-service writes the configuration to flash when it stops;
        # systemd starts it again right away.
        result = subprocess.run(["systemctl", "--user", "restart", "firestudio-tube-ctl"],
                                capture_output=True, text=True)
        ok = result.returncode == 0
        msg = Gtk.MessageDialog(transient_for=self, modal=True, buttons=Gtk.ButtonsType.OK,
                                message_type=Gtk.MessageType.INFO if ok else Gtk.MessageType.ERROR,
                                text="Configuração gravada na placa." if ok
                                else "Não foi possível gravar.",
                                secondary_text=None if ok else result.stderr.strip())
        msg.run()
        msg.destroy()
        self.tube = None
        GLib.timeout_add(2500, self.connect_device)

    # Meters -----------------------------------------------------------------------
    def poll_meters(self):
        if not self.tube:
            return True
        try:
            ins, outs = self.tube.read_meters()
            sat = self.tube.read_saturation()
        except (subprocess.CalledProcessError, KeyError, IndexError, ValueError):
            return True
        for strip, raw in zip(self.strips, ins):
            db = meter_db(raw)
            strip.meter.set_value(meter_fraction(db))
            strip.peak.update(db)
        k, start = self.out, OUTPUTS[self.out][1]
        on = self.mixer_on(k)
        for i, (meter, peak) in enumerate(zip(self.out_meters, self.out_peaks)):
            db = meter_db(outs[start + i])
            meter.set_value(meter_fraction(db))
            peak.update(db, clipped=on and sat[2 * k + i])
        return True


