def fmt_db(db):
    if db <= FADER_MIN:
        return "-∞"
    return "0.0" if abs(db) < 0.05 else f"{db:+.1f}"


def meter_db(raw):
    return tube.meter_to_db(raw)


def meter_fraction(db):
    return 0.0 if db == -math.inf else max(0.0, min(1.0, (db - METER_FLOOR) / -METER_FLOOR))


def ctrl_click_resets(scale, default):
    """Ctrl + click puts the control back to its default position."""
    def pressed(_w, event):
        if event.button == 1 and event.state & Gdk.ModifierType.CONTROL_MASK:
            scale.set_value(default)
            return True
        return False
    scale.connect("button-press-event", pressed)


def new_meter(vertical=True, length=170):
    bar = Gtk.LevelBar(min_value=0.0, max_value=1.0)
    bar.set_orientation(Gtk.Orientation.VERTICAL if vertical else Gtk.Orientation.HORIZONTAL)
    bar.set_inverted(vertical)
    bar.remove_offset_value(Gtk.LEVEL_BAR_OFFSET_LOW)
    bar.remove_offset_value(Gtk.LEVEL_BAR_OFFSET_HIGH)
    bar.add_offset_value("high", 1 - 12 / -METER_FLOOR)   # -12 dBFS
    bar.add_offset_value("full", 1 - 3 / -METER_FLOOR)    # -3 dBFS
    bar.set_size_request(7, length) if vertical else bar.set_size_request(length, 7)
    return bar


class Peak:
    """Peak-hold readout above a meter, showing CLIP like Universal Control."""

    def __init__(self):
        self.label = Gtk.Label(label="-∞", width_chars=5)
        self.label.get_style_context().add_class("peak")
        self.value = -math.inf
        self.ticks = 0
        self.clipped = False

    def update(self, db, clipped=False):
        if db >= self.value or self.ticks <= 0:
            self.value, self.ticks = db, PEAK_HOLD_TICKS
        else:
            self.ticks -= 1
        self.clipped = self.clipped or clipped or db >= CLIP_DB
        ctx = self.label.get_style_context()
        if self.clipped:
            self.label.set_text("CLIP")
            ctx.add_class("clip")
        else:
            self.label.set_text("-∞" if self.value == -math.inf else f"{self.value:.0f}")
            ctx.remove_class("clip")

    def reset(self):
        self.clipped = False
        self.value = -math.inf


# ----------------------------------------------------------------------------
# Mix state (master, mute, solo, link are not stored on the device)
# ----------------------------------------------------------------------------

def blank_channel():
    return {"db": FADER_MIN, "pan": 0.0, "mute": False, "solo": False}


def blank_state():
    return {"mixes": [{"master": 0.0, "ch": [blank_channel() for _ in range(tube.MIXER_INPUTS)]}
                      for _ in OUTPUTS],
            "links": [False] * (tube.MIXER_INPUTS // 2)}


def mix_gains(state, k):
    """Gains (left row, right row) to write to the device for output mix k."""
    mix = state["mixes"][k]
    solo = any(c["solo"] for c in mix["ch"])
    left, right = [], []
    for c in mix["ch"]:
        if c["mute"] or (solo and not c["solo"]) or c["db"] <= FADER_MIN or \
                mix["master"] <= FADER_MIN:
            l = r = 0
        else:
            l, r = tube.level_pan_to_stereo(tube.db_to_gain(c["db"] + mix["master"]), c["pan"])
        left.append(l)
        right.append(r)
    return left, right


def mix_from_device(left, right):
    mix = {"master": 0.0, "ch": []}
    for l, r in zip(left, right):
        level, pan = tube.stereo_to_level_pan(l, r)
        db = tube.gain_to_db(level)
        mix["ch"].append({"db": FADER_MIN if db == -math.inf else max(FADER_MIN, min(FADER_MAX, db)),
                          "pan": max(-1.0, min(1.0, pan)), "mute": False, "solo": False})
    return mix


def close(a, b):
    return all(abs(x - y) <= 2 for x, y in zip(a, b))


def load_state(t):
    """Saved UI state, re-derived from the device for any mix changed elsewhere."""
    try:
        with open(STATE_FILE) as f:
            saved = json.load(f)
    except (OSError, ValueError):
        saved = {}
    state = saved if isinstance(saved.get("mixes"), list) and \
        len(saved["mixes"]) == len(OUTPUTS) else dict(blank_state(), out=saved.get("out", 0))
    for k in range(len(OUTPUTS)):
        dev_l, dev_r = t.mixer_gains(2 * k), t.mixer_gains(2 * k + 1)
        l, r = mix_gains(state, k)
        if not (close(l, dev_l) and close(r, dev_r)):
            state["mixes"][k] = mix_from_device(dev_l, dev_r)
    return state


def save_state(state):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=1)


